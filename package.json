{
  "name": "fitrank",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Explainable fashion decision and recommendation engine",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "prepare-mnist": "node experiments/prepare-mnist.mjs",
    "ml:split": "node ml/src/data/build.mjs",
    "ml:embed": "node ml/src/embed/embed.mjs",
    "eval:arm": "node ml/src/eval/runEval.mjs",
    "eval:val": "node ml/src/eval/tuneVal.mjs",
    "embed-retrieval": "node experiments/embed.mjs",
    "shopper:pool": "node ml/src/eval/shopper/pool.mjs",
    "shopper:ingest": "node ml/src/eval/shopper/ingest.mjs",
    "shopper:influence": "node ml/src/eval/shopper/influence.mjs",
    "shopper:tune": "node ml/src/eval/shopper/tune.mjs",
    "sidecar": "node ml/src/server/inference.js"
  }
